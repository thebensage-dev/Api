# Environment of the "api" app in Coolify. Don't type these in: the deploy job in
# .github/workflows/ci.yml writes them, derived from the DOMAIN variable (see README, "Deploying").

# Generated by Coolify on the first deploy (not in this list): SERVICE_PASSWORD_64_APIDB, the
# PostgreSQL password.

# The image tag to run (sha-<commit>); set on every deploy.
API_IMAGE_TAG=main
# authentik's OAuth base, ending in a slash.
AUTH_AUTHORITY=https://id.example.com/application/o/
# Optional: "true" for the first deploy only, to add the 12 demo users.
SEED_DEMO_DATA=
